# Portable git config, symlinked from dotfiles/config/shared/.gitconfig.
#
# The machine-specific half — the path to 1Password's SSH signing binary, which
# differs per OS — is written to ~/.config/git/config by steps/shared/40-git.sh.
# Git reads that file too, before this one, so anything here wins on a clash.
#
# Not an [include]: git resolves a relative include path against the directory
# of the file containing it, which for a symlinked ~/.gitconfig is this repo,
# and it does not expand ~/ in include.path either. Both were tested.

[user]
	email = j.a.kallergis@gmail.com
	name = John A. Kallergis
	signingkey = ssh-rsa 

[gpg]
	format = ssh

[commit]
	gpgsign = true

[init]
	defaultBranch = main

# delta, installed by mise. Set here rather than by a step so there is one
# source of truth.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true

[gitbutler]
	signCommits = true
	aiModelProvider = openai

# gh as the credential helper, found on PATH instead of by absolute path so this
# line works on Linux too. The empty helper first clears any inherited default.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
